[Desktop Entry]
Type=Application
Version=1.0
Name=Nastro
GenericName=Music Player
Comment=A lightweight, skinnable desktop music player
Exec=nastro %U
Icon=codes.tanis.nastro
Terminal=false
Categories=AudioVideo;Audio;Player;
